{
  "expo": {
    "name": "TuCAN!",
    "slug": "vasy-app",
    "scheme": "vasy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121417",
    "splash": {
      "backgroundColor": "#121417"
    },
    "ios": {
      "bundleIdentifier": "com.tania.vasy",
      "supportsTablet": false
    },
    "android": {
      "package": "com.tania.vasy",
      "adaptiveIcon": {
        "backgroundColor": "#121417"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "experiments": {
      "baseUrl": "/TuCan"
    }
  }
}
